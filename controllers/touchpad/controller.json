      "group": "Two pads",
      "showIf": {
        "split": true
      }
    },
    {
      "id": "rightScale",
      "name": "Right: scale",
      "type": "choice",
      "options": [
        "Same as left",
        "All notes",
        "Major",
        "Minor",
        "Dorian",
        "Mixolydian",
        "Harmonic minor",
        "Pentatonic major",
        "Pentatonic minor",
        "Blues",

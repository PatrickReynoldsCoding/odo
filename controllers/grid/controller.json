      "options": [
        "Same as left",
        "Major",
        "Minor",
        "Dorian",
        "Mixolydian",
        "Harmonic minor",
        "Pentatonic major",
        "Pentatonic minor",
        "Blues",
        "Chromatic"
      ],
      "default": 0,
      "group": "Second grid",
      "showIf": {
        "split": true
      }
    },
    {
      "id": "topKey",
      "name": "Right grid: key",
      "type": "choice",
      "options": [
        "Same as left",
        "C",
        "C♯",
        "D",
        "E♭",
        "E",
        "F",
        "F♯",
        "G",
        "A♭",
        "A",
        "B♭",
        "B"
      ],
      "default": 0,
      "group": "Second grid",
      "showIf": {
        "split": true
      }
    },
    {
      "id": "topOctave",

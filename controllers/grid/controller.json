{
  "format": 1,
  "id": "patrickreynolds/grid",
  "version": "2.5.0",
  "name": "Grid",
  "description": "Square keys, played landscape: notes climb up the columns, or along each row on its own, or any square any note. In a square, a finger's height is its loudness and its place across its tone; slide out past its edge to bend or change the tone; wiggle for vibrato",
  "author": "Patrick Reynolds",
  "licence": "MIT",
  "needs": {
    "fingers": 10,
    "touchSize": false
  },
  "orientation": "landscape",
  "parts": [
    "Left",
    "Right"
  ],
  "partsFrom": "split",
  "arp": "app",
  "settings": [
    {
      "id": "cols",
      "name": "Squares top to bottom",
      "type": "number",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 3,
      "group": "Layout"
    },
    {
      "id": "layout",
      "name": "Mode",
      "type": "choice",
      "options": [
        "Wrap",
        "Sliding rows",
        "Custom",
        "Intervals"
      ],
      "default": 0,
      "group": "Layout"
    },
    {
      "id": "scrollLock",
      "name": "Lock row scrolling",
      "type": "switch",
      "default": true,
      "group": "Layout",
      "showIf": {
        "layout": 1
      }
    },
    {
      "id": "split",
      "name": "Second grid on the right",
      "type": "switch",
      "default": false,
      "group": "Second grid"
    },
    {
      "id": "splitSize",
      "name": "Right grid's share (%)",
      "type": "number",
      "min": 20,
      "max": 80,
      "step": 5,
      "default": 50,
      "group": "Second grid",
      "showIf": {
        "split": true
      }
    },
    {
      "id": "topWay",
      "name": "Right grid: columns",
      "type": "choice",
      "options": [
        "Mirrored",
        "Same way round"
      ],
      "default": 0,
      "group": "Second grid",
      "showIf": {
        "split": true
      }
    },
    {
      "id": "topNotes",
      "name": "Right grid: notes",
      "type": "choice",
      "options": [
        "Same as left",
        "The scale's notes",
        "Chromatic"
      ],
      "default": 0,
      "group": "Second grid",
      "showIf": {
        "split": true
      }
    },
    {
      "id": "topScale",
      "name": "Right grid: scale",

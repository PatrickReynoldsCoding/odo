{
  "format": 1,
  "id": "patrickreynolds/grid",
  "version": "1.9.1",
  "name": "Grid",
  "description": "Square keys, upright: the notes climb row by row, or up each column on its own; drag to bend toward the next, wiggle for vibrato",
  "author": "Patrick Reynolds",
  "licence": "MIT",
  "needs": {
    "fingers": 10,
    "touchSize": false
  },
  "orientation": "any",
  "parts": [
    "Bottom",
    "Top"
  ],
  "partsFrom": "split",
  "arp": "app",
  "settings": [
    {
      "id": "cols",
      "name": "Squares across",
      "type": "number",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 3,
      "group": "Layout"
    },
    {
      "id": "layout",
      "name": "Notes run",
      "type": "choice",
      "options": [
        "Along the rows",
        "Up each column"
      ],
      "default": 0,
      "group": "Layout"
    },
    {
      "id": "scrollLock",
      "name": "Lock column scrolling",
      "type": "switch",
      "default": true,
      "group": "Layout"
    },
    {
      "id": "split",
      "name": "Split: a second grid across the top",
      "type": "switch",
      "default": false,
      "group": "Split"
    },
    {
      "id": "splitSize",
      "name": "Top's share (%)",
      "type": "number",
      "min": 20,
      "max": 80,
      "step": 5,
      "default": 50,
      "group": "Split"
    },
    {
      "id": "topWay",
      "name": "Top: rows",
      "type": "choice",
      "options": [
        "Mirrored",
        "Same way up"
      ],
      "default": 0,
      "group": "Split"
    },
    {
      "id": "topNotes",
      "name": "Top: notes",
      "type": "choice",
      "options": [
        "Same as bottom",
        "The scale's notes",
        "Chromatic"
      ],
      "default": 0,
      "group": "Split"
    },
    {
      "id": "topScale",
      "name": "Top: scale",
      "type": "choice",
      "options": [
        "Same as bottom",
        "Major",
        "Minor",
        "Dorian",
        "Mixolydian",
        "Harmonic minor",
        "Pentatonic major",
        "Pentatonic minor",
        "Blues",
        "Chromatic"
      ],
      "default": 0,
      "group": "Split"
    },
    {
      "id": "topKey",
      "name": "Top: key",
      "type": "choice",
      "options": [
        "Same as bottom",
        "C",
        "C♯",
        "D",
        "E♭",
        "E",
        "F",
        "F♯",
        "G",
        "A♭",
        "A",
        "B♭",
        "B"
      ],
      "default": 0,
      "group": "Split"
    },
    {
      "id": "topOctave",
      "name": "Top: octave (from bottom's)",
      "type": "number",
      "min": -3,
      "max": 3,
      "step": 1,
      "default": 0,
      "group": "Split"
    },
    {
      "id": "squareSize",
      "name": "Square size (%)",
      "type": "number",
      "min": 50,
      "max": 100,
      "step": 5,
      "default": 100,
      "group": "Layout"
    },
    {
      "id": "spacing",
      "name": "Spacing (%)",
      "type": "number",
      "min": 2,
      "max": 30,
      "step": 1,
      "default": 9,
      "group": "Layout"
    },
    {
      "id": "flipAcross",
      "name": "Flip across",
      "type": "switch",
      "default": false,
      "group": "Layout"
    },
    {
      "id": "flipUpDown",
      "name": "Flip up/down",
      "type": "switch",
      "default": false,
      "group": "Layout"
    },
    {
      "id": "chromatic",
      "name": "Notes",
      "type": "choice",
      "options": [
        "The scale's notes",
        "Chromatic"
      ],
      "default": 0,
      "group": "Notes"
    },
    {
      "id": "scale",
      "name": "Scale",
      "type": "choice",
      "options": [
        "Major",
        "Minor",
        "Dorian",
        "Mixolydian",
        "Harmonic minor",
        "Pentatonic major",
        "Pentatonic minor",
        "Blues",
        "Chromatic"
      ],
      "default": 0,
      "group": "Notes"
    },
    {
      "id": "key",
      "name": "Key",
      "type": "choice",
      "options": [
        "C",
        "C♯",
        "D",
        "E♭",
        "E",
        "F",
        "F♯",
        "G",
        "A♭",
        "A",
        "B♭",
        "B"
      ],
      "default": 0,
      "group": "Notes"
    },
    {
      "id": "octave",
      "name": "Octave",
      "type": "number",
      "min": -3,
      "max": 3,
      "step": 1,
      "default": 0,
      "group": "Notes"
    },
    {
      "id": "xTarget",
      "name": "Across",
      "type": "choice",
      "options": [
        "Nothing",
        "Loudness",
        "Tone",
        "Bend",
        "Volume"
      ],
      "default": 3,
      "hidden": true,
      "group": "Touch"
    },
    {
      "id": "yTarget",
      "name": "Up/down",
      "type": "choice",
      "options": [
        "Nothing",
        "Loudness",
        "Tone",
        "Bend",
        "Volume"
      ],
      "default": 2,
      "hidden": true,
      "group": "Touch"
    },
    {
      "id": "bendRange",
      "name": "Bend range",
      "type": "choice",
      "options": [
        "Next note",
        "±1",
        "±2",
        "±3",
        "±5",
        "±7",
        "±12"
      ],
      "default": 0,
      "hidden": true,
      "group": "Touch"
    },
    {
      "id": "bendSnap",
      "name": "Bend snap (%)",
      "type": "number",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 0,
      "hidden": true,
      "group": "Touch"
    },
    {
      "id": "zoneEdit",
      "name": "Edit touch & strike zones",
      "type": "switch",
      "default": false,
      "group": "Touch"
    },
    {
      "id": "zoneBlend",
      "name": "Smooth between zones",
      "type": "switch",
      "default": true,
      "group": "Touch"
    },
    {
      "id": "strikeRangeDb",
      "name": "Strike range (dB)",
      "type": "number",
      "min": 0,
      "max": 60,
      "step": 1,
      "default": 24,
      "hidden": true,
      "group": "Touch"
    },
    {
      "id": "vibrato",
      "name": "Vibrato",
      "type": "choice",
      "options": [
        "Off",
        "Light",
        "Normal",
        "Wide"
      ],
      "default": 2,
      "group": "Touch"
    },
    {
      "id": "labels",
      "name": "Note names",
      "type": "switch",
      "default": false,
      "group": "Look"
    },
    {
      "id": "theme",
      "name": "Look",
      "type": "choice",
      "options": [
        "Neon",
        "Ember",
        "Ice",
        "Violet",
        "Sunset",
        "Paper"
      ],
      "default": 0,
      "group": "Look"
    },
    {
      "id": "colours",
      "name": "Colours",
      "type": "choice",
      "options": [
        "Plain",
        "Every degree",
        "Chord tones",
        "Root, 4th, 5th",
        "By note name"
      ],
      "default": 0,
      "group": "Look"
    },
    {
      "id": "sameNotes",
      "name": "Same notes elsewhere",
      "type": "choice",
      "options": [
        "Off",
        "Ring",
        "Glow"
      ],
      "default": 1,
      "group": "Look"
    },
    {
      "id": "latch",
      "name": "Latch",
      "type": "switch",
      "default": false,
      "group": "Playing"
    },
    {
      "id": "latchMode",
      "name": "Latch: the next touch",
      "type": "choice",
      "options": [
        "New hand replaces",
        "Tap on, tap off"
      ],
      "default": 0,
      "group": "Playing"
    },
    {
      "id": "scrollBar",
      "name": "Scroll bar",
      "type": "choice",
      "options": [
        "Off",
        "Left",
        "Right"
      ],
      "default": 2,
      "group": "Controls"
    },
    {
      "id": "sideLatch",
      "name": "Latch button",
      "type": "choice",
      "options": [
        "Off",
        "Left",
        "Right"
      ],
      "default": 1,
      "group": "Controls"
    },
    {
      "id": "sideHold",
      "name": "Hold button",
      "type": "choice",
      "options": [
        "Off",
        "Left",
        "Right"
      ],
      "default": 0,
      "group": "Controls"
    },
    {
      "id": "sideBend",
      "name": "Bend slider",
      "type": "choice",
      "options": [
        "Off",
        "Left",
        "Right"
      ],
      "default": 0,
      "group": "Controls"
    },
    {
      "id": "sideTone",
      "name": "Tone slider",
      "type": "choice",
      "options": [
        "Off",
        "Left",
        "Right"
      ],
      "default": 0,
      "group": "Controls"
    },
    {
      "id": "sideDyn",
      "name": "Dynamics fader",
      "type": "choice",
      "options": [
        "Off",
        "Left",
        "Right"
      ],
      "default": 1,
      "group": "Controls"
    },
    {
      "id": "sideLock",
      "name": "Lock button (columns)",
      "type": "choice",
      "options": [
        "Off",
        "Left",
        "Right"
      ],
      "default": 2,
      "group": "Controls"
    },
    {
      "id": "turn",
      "name": "Turn",
      "type": "choice",
      "options": [
        "Auto (sideways when wide)",
        "Upright",
        "Sideways"
      ],
      "default": 0,
      "group": "Layout"
    },
    {
      "id": "zoneMap",
      "name": "Strike zones",
      "type": "number",
      "min": 0,
      "max": 10077695,
      "step": 1,
      "default": 6046617,
      "hidden": true,
      "group": "Touch"
    },
    {
      "id": "zonePreset1",
      "name": "Strike zones 1",
      "type": "number",
      "min": 0,
      "max": 10077695,
      "step": 1,
      "default": 6046617,
      "hidden": true,
      "group": "Touch"
    },
    {
      "id": "zonePreset2",
      "name": "Strike zones 2",
      "type": "number",
      "min": 0,
      "max": 10077695,
      "step": 1,
      "default": 6046617,
      "hidden": true,
      "group": "Touch"
    },
    {
      "id": "zonePreset3",
      "name": "Strike zones 3",
      "type": "number",
      "min": 0,
      "max": 10077695,
      "step": 1,
      "default": 6046617,
      "hidden": true,
      "group": "Touch"
    },
    {
      "id": "zonePreset4",
      "name": "Strike zones 4",
      "type": "number",
      "min": 0,
      "max": 10077695,
      "step": 1,
      "default": 6046617,
      "hidden": true,
      "group": "Touch"
    },
    {
      "id": "dynamics",
      "name": "Dynamics",
      "type": "number",
      "min": 0,
      "max": 1,
      "step": 0,
      "default": 1,
      "hidden": true,
      "group": "Touch"
    },
    {
      "id": "acrossAmount",
      "name": "Across amount (%)",
      "type": "number",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 100,
      "hidden": true,
      "group": "Touch"
    },
    {
      "id": "acrossSensitivity",
      "name": "Across sensitivity (%)",
      "type": "number",
      "min": 25,
      "max": 400,
      "step": 5,
      "default": 100,
      "hidden": true,
      "group": "Touch"
    },
    {
      "id": "acrossFlip",
      "name": "Across flipped",
      "type": "switch",
      "default": false,
      "hidden": true,
      "group": "Touch"
    },
    {
      "id": "upDownAmount",
      "name": "Up/down amount (%)",
      "type": "number",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 100,
      "hidden": true,
      "group": "Touch"
    },
    {
      "id": "upDownSensitivity",
      "name": "Up/down sensitivity (%)",
      "type": "number",
      "min": 25,
      "max": 400,
      "step": 5,
      "default": 100,
      "hidden": true,
      "group": "Touch"
    },
    {
      "id": "upDownFlip",
      "name": "Up/down flipped",
      "type": "switch",
      "default": false,
      "hidden": true,
      "group": "Touch"
    }
  ]
}
